{
  "name": "@dirac-grid/diracx-web-components",
  "version": "0.1.0-a11",
  "repository": "https://github.com/DIRACGrid/diracx-web",
  "description": "Useful components for diracx-web",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup --minify && node scripts/verify-dist.mjs",
    "dev": "tsup --watch",
    "test": "jest --ci",
    "test:coverage": "jest --ci --coverage",
    "lint": "eslint ./src",
    "lint-staged": "lint-staged",
    "ts-lint": "tsc -noEmit -incremental",
    "prepack": "rm -rf dist && npm run build",
    "doc": "storybook dev -p 6006",
    "build-doc": "storybook build"
  },
  "license": "GPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": [
    "**/*.css",
    "**/SearchBar/DatePicker.*"
  ],
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.3.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^1.0.3",
    "@atlaskit/pragmatic-drag-and-drop-react-drop-indicator": "^3.0.0",
    "@mui/utils": "^7.0.0",
    "@mui/x-charts": "^8.0.0",
    "@mui/x-date-pickers": "^8.0.0",
    "@tanstack/react-table": "^8.20.5",
    "@tanstack/react-virtual": "^3.13.23",
    "dayjs": "^1.11.13"
  },
  "peerDependencies": {
